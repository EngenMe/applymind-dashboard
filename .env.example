# ──────────────────────────────────────────────────────────────────────────
# Required on every deployment — local dev, applymind.dev, and the
# applymind.faroukhasnaoui.tech showcase alike.
# ──────────────────────────────────────────────────────────────────────────

# Your API Gateway stage. No trailing slash.
APPLYMIND_API_BASE_URL=https://abc123.execute-api.eu-west-1.amazonaws.com/prod

# ──────────────────────────────────────────────────────────────────────────
# Demo mode — only for the showcase deployment, or local testing of it.
# Leave both of these false/unset for the real app: applymind.dev never runs
# in demo mode, full stop.
# ──────────────────────────────────────────────────────────────────────────

# DEMO_MODE and NEXT_PUBLIC_DEMO_MODE must always be set to the SAME value.
# They are not the same setting read twice — DEMO_MODE is read server-side
# (middleware.ts, session.ts, the API proxy in route.ts); Next only inlines
# NEXT_PUBLIC_-prefixed vars into the browser bundle, so client components
# like main-nav.tsx need their own copy to know which mode they're in.
# Setting only one leaves the server and the client disagreeing — e.g. the
# server correctly skips auth on /applications while the nav still waits on
# a login that was never going to happen there.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# A real, READ-ONLY API token for the seeded demo account
# (demo@applymind.faroukhasnaoui.tech). Mint it directly — see
# internal/auth/service.go's hashToken (plain SHA-256, hex-encoded) if you
# ever need to insert one by hand, since that account's password_hash is
# intentionally not a valid bcrypt string and can never sign in interactively.
#
# Required when DEMO_MODE=true, so signed-out visitors can read the seeded
# data. Must stay UNSET on applymind.dev — its presence there would let a
# signed-out visitor read demo data on the real domain instead of hitting a
# clean 401, which defeats the point of requiring sign-in at all.
# APPLYMIND_DEMO_TOKEN=