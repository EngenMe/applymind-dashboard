# Base URL of the deployed API Gateway stage, no trailing slash.
APPLYMIND_API_BASE_URL=https://abc123.execute-api.eu-west-1.amazonaws.com/prod

# The API key the backend's middleware expects. Server-side only — it is read
# inside src/app/api/backend/[...path]/route.ts and never shipped to the browser.
APPLYMIND_API_KEY=replace-me
